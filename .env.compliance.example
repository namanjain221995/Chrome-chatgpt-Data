# Configuration for scripts/probe_compliance_api.py
#
#   cp .env.compliance.example .env.compliance
#
# .env.compliance is gitignored. It holds a live credential and must never be
# committed, pasted into a chat, or attached to a ticket.
#
# This file configures a *probe*, not the running system. Production reads the
# same values from AWS SSM Parameter Store; see docs/COMPLIANCE_ADAPTER.md.

# ---------------------------------------------------------------------------
# REQUIRED - from the Compliance API documentation supplied with your OpenAI
# Enterprise agreement. These are deliberately not guessed: a wrong path
# returns an error indistinguishable from "this workspace has no data".
# ---------------------------------------------------------------------------

# Host only, no trailing slash. e.g. https://api.openai.com
OPENAI_COMPLIANCE_BASE_URL=https://api.openai.com

# Path of the conversation/event log endpoint, e.g. /v1/organization/<something>
OPENAI_COMPLIANCE_LOG_PATH=

# The Compliance API key. ChatGPT admin -> Access tokens.
OPENAI_COMPLIANCE_API_KEY=at-loaWnFn3HA29rPtAUdUzcKFsX29xklINwEys0LbMlRQ

# ---------------------------------------------------------------------------
# Workspace identity - from ChatGPT admin -> General -> Workspace IDs
# ---------------------------------------------------------------------------
OPENAI_ORG_ID=org-L2HZ7TLpqKI1ojV2tpkZRfGg
OPENAI_WORKSPACE_ID=54157298-b257-4944-886e-5838eff84eec

# ---------------------------------------------------------------------------
# OPTIONAL - defaults suit a conventional cursor-paginated JSON API. Change
# them only where the documentation says otherwise.
# ---------------------------------------------------------------------------

# Authorization header shape.
OPENAI_COMPLIANCE_AUTH_HEADER=Authorization
OPENAI_COMPLIANCE_AUTH_SCHEME=Bearer

# Extra query parameters as a JSON object, e.g. a time window or page size:
#   {"since":"2026-08-01T00:00:00Z","limit":"25"}
OPENAI_COMPLIANCE_QUERY=

# Where the interesting values sit in the response. Dotted paths.
OPENAI_COMPLIANCE_ITEMS_FIELD=data
OPENAI_COMPLIANCE_CURSOR_FIELD=next_cursor
OPENAI_COMPLIANCE_HAS_MORE_FIELD=has_more

# Query parameter used to request the next page.
OPENAI_COMPLIANCE_CURSOR_PARAM=after
