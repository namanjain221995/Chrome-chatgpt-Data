# Copy to .env only for local development.
#
# Production never uses this file. `scripts/fetch_ssm_secrets.sh` renders
# /opt/techsara-chat-archive/.env.production on the EC2 host from AWS SSM
# Parameter Store. Values here are placeholders or fail-closed defaults; no
# credential belongs in Git.

ENVIRONMENT=development
APP_NAME=techsara-chat-archive
PUBLIC_BASE_URL=http://127.0.0.1:8000
API_BASE_PATH=/api/v1
DATA_ROOT=/srv/techsara-chat-archive

# Container image. Built locally and on the EC2 host; never pulled from a
# registry. Production sets IMAGE_TAG to the full deployed Git SHA.
IMAGE_NAME=techsara-chat-archive-backend
IMAGE_TAG=local

# PostgreSQL. Put the production password in SSM SecureString, never here.
POSTGRES_DB=techsara_chat_archive
POSTGRES_USER=techsara_app
POSTGRES_PASSWORD=devonly_change_me

# Connection pooling. Every application process owns a pool, so the worst case
# is (POOL_SIZE + MAX_OVERFLOW) * (API_WORKERS + worker + poller). It must stay
# under POSTGRES_MAX_CONNECTIONS minus a 15-connection reserve, and the
# application refuses to start in production if it does not. See docs/CAPACITY.md.
POSTGRES_MAX_CONNECTIONS=120
DATABASE_POOL_SIZE=12
DATABASE_MAX_OVERFLOW=4
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_POOL_PRE_PING=true

# AWS S3. Production uses the EC2 instance role and the normal AWS credential
# chain. The endpoint override must remain empty and path-style must stay off.
AWS_REGION=us-east-1
S3_BUCKET=techsara-chatgpt
S3_ENDPOINT_URL=
S3_USE_PATH_STYLE=false
S3_ENCRYPTION_MODE=SSE-S3
S3_KMS_KEY_ID=
# Readiness caches the HeadBucket probe for this long so polling stays cheap.
S3_HEALTH_CACHE_SECONDS=60
S3_HEALTH_TIMEOUT_SECONDS=5

# OIDC and managed extension identity.
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=REPLACE_WITH_OIDC_CLIENT_ID
OIDC_REQUIRED_HD=example.com
ALLOWED_EMAIL_DOMAINS=example.com
EXTENSION_IDS=
ADMIN_ORIGINS=
MANAGED_WORKSPACE_LABEL=REPLACE_WITH_MANAGED_WORKSPACE_LABEL
MANAGED_WORKSPACE_IDS=54157298-b257-4944-886e-5838eff84eec
OPENAI_WORKSPACE_ID=
PGADMIN_DEFAULT_EMAIL=dba@example.com

# Capture stays fail-closed until legal approval and the staged rollout.
BROWSER_CONTENT_CAPTURE_ENABLED=false
OPENAI_WRITTEN_AUTHORIZATION_CONFIRMED=false
TRAINING_EXPORT_ENABLED=false
AUTO_ARCHIVE_CURRENT_OPEN_CHAT=true
ATTACHMENT_CAPTURE_ENABLED=true
KILL_SWITCH_ENABLED=false

# Optional authorized compliance feed. No endpoint path is assumed.
COMPLIANCE_POLL_ENABLED=false
OPENAI_COMPLIANCE_BASE_URL=
OPENAI_COMPLIANCE_LOG_PATH=
OPENAI_COMPLIANCE_FILES_PATH=
COMPLIANCE_POLL_INTERVAL_SECONDS=300
COMPLIANCE_OVERLAP_SECONDS=600

# Runtime sizing for an initial 2 vCPU / 8 GiB host.
API_WORKERS=3
WORKER_CONCURRENCY=2
RATE_LIMIT_REQUESTS_PER_MINUTE=300
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=90
RAW_RETENTION_DAYS=365
# Interactive API docs at /docs. On by default outside production; in
# production it must be enabled explicitly AND protected by Cloudflare
# Access, or it publishes the whole admin and ingest surface.
API_DOCS_ENABLED=false
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_MESSAGE_CONTENT=false

# Public identity. Cloudflare terminates TLS and a named Cloudflare Tunnel is
# the only public ingress, so no port is published for the API and there is no
# origin certificate. ARCHIVE_HOSTNAME is derived from PUBLIC_BASE_URL in
# production; it is set explicitly only for local production-shaped tests.
ARCHIVE_HOSTNAME=archive.example.com
# Loopback-only management bindings.
CLOUDFLARED_METRICS_PORT=2000
PGADMIN_PORT=5050

# SSM path used by the deployment scripts on the EC2 host.
PROJECT_NAME=techsara-chat-archive
SSM_PARAMETER_PREFIX=/techsara-chat-archive
