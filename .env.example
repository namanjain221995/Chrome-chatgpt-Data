# =============================================================================
# TechSara Managed ChatGPT Session Archive - example environment
# Copy to .env and replace every REPLACE placeholder.
# NEVER commit a filled-in .env. NEVER reuse these example values in production.
# =============================================================================

ENVIRONMENT=development
APP_NAME=techsara-chat-archive
PUBLIC_BASE_URL=https://archive.example.com
API_BASE_PATH=/api/v1

# -----------------------------------------------------------------------------
# PostgreSQL (runs in the `postgres` Docker service; never publicly exposed)
# -----------------------------------------------------------------------------
POSTGRES_DB=techsara_chat_archive
POSTGRES_USER=techsara_app
# Development only. In production POSTGRES_PASSWORD is unset and
# POSTGRES_PASSWORD_FILE points at a root-owned file rendered from SSM.
POSTGRES_PASSWORD=devonly_change_me
POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
DATABASE_URL=postgresql+asyncpg://techsara_app:devonly_change_me@postgres:5432/techsara_chat_archive
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=20
DATABASE_STATEMENT_TIMEOUT_MS=30000

# -----------------------------------------------------------------------------
# AWS / S3
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
S3_BUCKET=replace-account-region-techsara-chat-archive
# Leave empty in AWS production. Set to http://minio:9000 for local dev only.
S3_ENDPOINT_URL=
S3_USE_PATH_STYLE=false
S3_ENCRYPTION_MODE=SSE-S3
S3_KMS_KEY_ID=
PRESIGNED_UPLOAD_TTL_SECONDS=300
PRESIGNED_DOWNLOAD_TTL_SECONDS=300
MAX_ATTACHMENT_BYTES=20971520
# Dev-only static credentials for MinIO. In production the EC2 instance profile
# supplies credentials and these MUST be empty.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# -----------------------------------------------------------------------------
# Authentication (company Google Workspace / OIDC)
# -----------------------------------------------------------------------------
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=replace-me
OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc_client_secret
OIDC_JWKS_URL=
OIDC_REQUIRED_HD=example.com
ALLOWED_EMAIL_DOMAINS=example.com
EXTENSION_IDS=replace-after-build
ADMIN_ORIGINS=
# Backend session signing key. Generate with: openssl rand -base64 48
JWT_SECRET_FILE=/run/secrets/jwt_secret
JWT_SECRET=devonly_insecure_signing_key_change_me
ACCESS_TOKEN_TTL_SECONDS=1800
REFRESH_TOKEN_TTL_SECONDS=1209600
# Dev-only local IdP. Hard-blocked when ENVIRONMENT=production.
DEV_AUTH_ENABLED=true

# -----------------------------------------------------------------------------
# Capture policy gates (server-side; extension cannot override)
# -----------------------------------------------------------------------------
MANAGED_WORKSPACE_LABEL=TechSara's Workspace
MANAGED_WORKSPACE_IDS=
BROWSER_CONTENT_CAPTURE_ENABLED=false
OPENAI_WRITTEN_AUTHORIZATION_CONFIRMED=false
AUTO_ARCHIVE_CURRENT_OPEN_CHAT=true
ATTACHMENT_CAPTURE_ENABLED=true
PERSONAL_WORKSPACE_CAPTURE_ENABLED=false
CAPTURE_UNSENT_DRAFTS=false
KILL_SWITCH_ENABLED=false
CONFIG_SIGNING_KEY_FILE=/run/secrets/config_signing_key
CONFIG_SIGNING_KEY=devonly_insecure_config_key_change_me

# -----------------------------------------------------------------------------
# Compliance poller (disabled until authorized + configured)
# -----------------------------------------------------------------------------
COMPLIANCE_POLL_ENABLED=false
OPENAI_COMPLIANCE_BASE_URL=
OPENAI_COMPLIANCE_LOG_PATH=
OPENAI_COMPLIANCE_FILES_PATH=
OPENAI_COMPLIANCE_API_KEY_FILE=/run/secrets/openai_compliance_api_key
OPENAI_COMPLIANCE_API_KEY=
COMPLIANCE_POLL_INTERVAL_SECONDS=300
COMPLIANCE_OVERLAP_SECONDS=600
COMPLIANCE_PAGE_SIZE=100
COMPLIANCE_MAX_PAGES_PER_CYCLE=50

# -----------------------------------------------------------------------------
# Retention / export / offline queue
# -----------------------------------------------------------------------------
TRAINING_EXPORT_ENABLED=false
RAW_RETENTION_DAYS=365
BACKUP_RETENTION_DAYS=90
OFFLINE_QUEUE_MAX_ITEMS=10000
OFFLINE_QUEUE_MAX_BYTES=52428800
OFFLINE_QUEUE_MAX_AGE_DAYS=7

# -----------------------------------------------------------------------------
# Runtime / observability
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_MESSAGE_CONTENT=false
RATE_LIMIT_REQUESTS_PER_MINUTE=300
RATE_LIMIT_BURST=60
MAX_REQUEST_BYTES=2621440
MAX_BATCH_ITEMS=100
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_STALE_LOCK_SECONDS=300
JOB_QUEUE_BACKPRESSURE_THRESHOLD=50000
API_WORKERS=3

# -----------------------------------------------------------------------------
# Deployment-only (compose / Caddy)
# -----------------------------------------------------------------------------
CADDY_DOMAIN=archive.example.com
CADDY_EMAIL=ops@example.com
IMAGE_TAG=local
IMAGE_REPOSITORY=ghcr.io/replace-org/techsara-chat-archive
DATA_ROOT=/srv/techsara-chat-archive
PGADMIN_DEFAULT_EMAIL=dba@example.com
PGADMIN_DEFAULT_PASSWORD=devonly_change_me
BACKUP_CRON=15 3 * * *
