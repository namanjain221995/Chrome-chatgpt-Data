{
  "$defs": {
    "ClientContext": {
      "additionalProperties": false,
      "description": "Non-sensitive client provenance attached to every ingest request.",
      "properties": {
        "adapter_version": {
          "description": "DOM adapter version used for extraction",
          "maxLength": 32,
          "pattern": "^[A-Za-z0-9._+-]+$",
          "title": "Adapter Version",
          "type": "string"
        },
        "captured_at": {
          "description": "Client clock at capture time (UTC)",
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "device_fingerprint": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 16,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Device Fingerprint"
        },
        "extension_version": {
          "description": "Extension version that produced the payload",
          "maxLength": 32,
          "pattern": "^[A-Za-z0-9._+-]+$",
          "title": "Extension Version",
          "type": "string"
        },
        "page_locale": {
          "anyOf": [
            {
              "maxLength": 16,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Locale"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "extension_version",
        "adapter_version",
        "captured_at"
      ],
      "title": "ClientContext",
      "type": "object"
    },
    "WorkspaceRef": {
      "additionalProperties": false,
      "description": "How the extension identifies the workspace it observed.\n\n``verified`` is asserted by the client but re-checked server-side; the\nserver never stores content for an unverified or personal workspace.",
      "properties": {
        "kind": {
          "default": "unverified",
          "enum": [
            "managed_company",
            "personal",
            "unverified"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "source_workspace_id": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:@\\-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Workspace Id"
        },
        "verification_signals": {
          "items": {
            "maxLength": 64,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Verification Signals",
          "type": "array"
        },
        "verified": {
          "default": false,
          "title": "Verified",
          "type": "boolean"
        }
      },
      "title": "WorkspaceRef",
      "type": "object"
    }
  },
  "$id": "https://schemas.techsara.example/chat-archive/1.0/conversation-upsert-request.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "branch_hint": {
      "anyOf": [
        {
          "maxLength": 255,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Branch Hint"
    },
    "capture_completeness": {
      "default": "unknown",
      "enum": [
        "complete_current_page",
        "partial_scroll_limit",
        "live_only",
        "compliance_verified",
        "reconciled",
        "unknown"
      ],
      "title": "Capture Completeness",
      "type": "string"
    },
    "capture_source": {
      "default": "chrome_extension",
      "enum": [
        "chrome_extension",
        "compliance_api",
        "manual_import"
      ],
      "title": "Capture Source",
      "type": "string"
    },
    "client": {
      "$ref": "#/$defs/ClientContext"
    },
    "idempotency_key": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Idempotency Key",
      "type": "string"
    },
    "model_slug": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Slug"
    },
    "observed_message_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Observed Message Count"
    },
    "source_conversation_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:@\\-]+$",
      "title": "Source Conversation Id",
      "type": "string"
    },
    "source_created_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Created At"
    },
    "source_updated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Updated At"
    },
    "source_url": {
      "anyOf": [
        {
          "maxLength": 2048,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Url"
    },
    "title": {
      "anyOf": [
        {
          "maxLength": 2048,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Title"
    },
    "workspace": {
      "$ref": "#/$defs/WorkspaceRef"
    }
  },
  "required": [
    "idempotency_key",
    "source_conversation_id",
    "workspace",
    "client"
  ],
  "title": "ConversationUpsertIn",
  "type": "object"
}
