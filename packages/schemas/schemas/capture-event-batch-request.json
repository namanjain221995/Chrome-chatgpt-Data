{
  "$defs": {
    "CaptureEventIn": {
      "additionalProperties": false,
      "description": "Envelope for events that are not (yet) modelled as first-class rows.",
      "properties": {
        "idempotency_key": {
          "maxLength": 128,
          "minLength": 8,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Idempotency Key",
          "type": "string"
        },
        "kind": {
          "enum": [
            "conversation_upsert",
            "message_version",
            "attachment_metadata",
            "feedback",
            "diagnostic"
          ],
          "title": "Kind",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "payload": {
          "title": "Payload",
          "type": "object"
        },
        "source_conversation_id": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:@\\-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Conversation Id"
        },
        "source_message_id": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:@\\-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Message Id"
        }
      },
      "required": [
        "idempotency_key",
        "kind",
        "occurred_at"
      ],
      "title": "CaptureEventIn",
      "type": "object"
    },
    "ClientContext": {
      "additionalProperties": false,
      "description": "Non-sensitive client provenance attached to every ingest request.",
      "properties": {
        "adapter_version": {
          "description": "DOM adapter version used for extraction",
          "maxLength": 32,
          "pattern": "^[A-Za-z0-9._+-]+$",
          "title": "Adapter Version",
          "type": "string"
        },
        "captured_at": {
          "description": "Client clock at capture time (UTC)",
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "device_fingerprint": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 16,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Device Fingerprint"
        },
        "extension_version": {
          "description": "Extension version that produced the payload",
          "maxLength": 32,
          "pattern": "^[A-Za-z0-9._+-]+$",
          "title": "Extension Version",
          "type": "string"
        },
        "page_locale": {
          "anyOf": [
            {
              "maxLength": 16,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Locale"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "extension_version",
        "adapter_version",
        "captured_at"
      ],
      "title": "ClientContext",
      "type": "object"
    },
    "WorkspaceRef": {
      "additionalProperties": false,
      "description": "How the extension identifies the workspace it observed.\n\n``verified`` is asserted by the client but re-checked server-side; the\nserver never stores content for an unverified or personal workspace.",
      "properties": {
        "kind": {
          "default": "unverified",
          "enum": [
            "managed_company",
            "personal",
            "unverified"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "source_workspace_id": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:@\\-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Workspace Id"
        },
        "verification_signals": {
          "items": {
            "maxLength": 64,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Verification Signals",
          "type": "array"
        },
        "verified": {
          "default": false,
          "title": "Verified",
          "type": "boolean"
        }
      },
      "title": "WorkspaceRef",
      "type": "object"
    }
  },
  "$id": "https://schemas.techsara.example/chat-archive/1.0/capture-event-batch-request.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "client": {
      "$ref": "#/$defs/ClientContext"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/CaptureEventIn"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Events",
      "type": "array"
    },
    "workspace": {
      "$ref": "#/$defs/WorkspaceRef"
    }
  },
  "required": [
    "workspace",
    "events",
    "client"
  ],
  "title": "CaptureEventBatchIn",
  "type": "object"
}
